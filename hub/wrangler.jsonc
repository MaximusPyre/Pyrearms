{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "pyre-hub",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"routes": [
		{
			"pattern": "hub.pyrearms.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
