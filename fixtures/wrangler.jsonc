/**
 * Private classification-fixture host.
 * Change `routes[0].pattern` and `vars.FIXTURES_HOSTNAME` to use a different subdomain.
 *
 * Secrets (set with wrangler secret put, not in this file):
 *   FIXTURES_BASIC_PASSWORD
 *   FIXTURES_ACCESS_TOKEN
 */
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "pyre-fixtures",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "test-fixtures.pyrearms.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"vars": {
		"FIXTURES_HOSTNAME": "test-fixtures.pyrearms.dev",
		"FIXTURES_BASIC_USER": "fixtures",
		"FIXTURES_AUTH_MODE": "on",
		"FIXTURES_ALLOW_QUERY_TOKEN": "false"
	}
}
